# =============================================================================
# Zalo Qwen Assistant — Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Groq LLM ---
GROQ_API_KEY=
LLM_PRIMARY_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# --- Zalo real bridge ---
ADMIN_TOKEN=
ENABLE_ZALO_REAL=true

# --- Airtable ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Access control (comma-separated IDs) ---
BOT_TAGS=@Byron,@bot
ALLOWED_INTERNAL_GROUP_IDS=group_internal_demo
ALLOWED_CUSTOMER_GROUP_IDS=group_customer_demo
ADMIN_USER_IDS=4578787147549768359

# --- App ---
TTL_DAYS=3

# --- Zalo rate limiting ---
ZALO_MAX_MSG_PER_MIN=6
ZALO_MIN_DELAY_SEC=3
ZALO_MAX_DELAY_SEC=6
