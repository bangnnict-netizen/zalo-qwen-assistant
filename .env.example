# =============================================================================
# Zalo Qwen Assistant — Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Groq LLM ---
GROQ_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Airtable ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Access control (comma-separated IDs) ---
ALLOWED_INTERNAL_GROUP_IDS=
ALLOWED_CUSTOMER_GROUP_IDS=
ADMIN_USER_IDS=

# --- App ---
TTL_DAYS=3

# --- Zalo rate limiting ---
ZALO_MAX_MSG_PER_MIN=6
ZALO_MIN_DELAY_SEC=3
ZALO_MAX_DELAY_SEC=6
